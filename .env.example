# Copiar para .env.local e preencher. NUNCA versionar o .env.local.

# ── Supabase ────────────────────────────────────────────────────────────────
# Projeto próprio da campanha — NÃO usar a org "Setup".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no servidor. Dá acesso irrestrito ao banco, ignorando RLS.
# Se esta chave vazar, vazam os dados de todos os contatos.
SUPABASE_SERVICE_ROLE_KEY=

# ── Bloqueio de quem pediu saída ────────────────────────────────────────────
# Chave do HMAC que pseudonimiza o telefone na lista de bloqueio.
# Gerar com: openssl rand -hex 32
#
# ⚠️ TROCAR ESTA CHAVE INVALIDA A LISTA DE BLOQUEIO INTEIRA e faz quem pediu
#    saída voltar para a fila. Não rotacionar durante a campanha.
HMAC_SECRET=

# ── Links rastreados ────────────────────────────────────────────────────────
# Domínio curto e próprio, só para os links. Não usar encurtador público nem o
# domínio principal da campanha (docs/03-OPERACAO.md §13).
LINK_BASE_URL=
