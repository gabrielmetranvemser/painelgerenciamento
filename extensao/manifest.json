{
  "manifest_version": 3,
  "name": "Painel de Atendimento",
  "short_name": "Painel",
  "version": "1.1.0",
  "description": "Abre o painel de atendimento na lateral do navegador e reaproveita a aba do WhatsApp Web em vez de abrir uma nova.",
  "default_locale": "pt_BR",
  "key": "",
  "permissions": [
    "sidePanel",
    "tabs"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir o painel na lateral"
  },
  "icons": {
    "16": "icone16.png",
    "48": "icone48.png",
    "128": "icone128.png"
  },
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://exemplo.invalid/*"
    ]
  }
}
